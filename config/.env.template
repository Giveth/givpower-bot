NODE_URL='https://rpc.gnosischain.com/'
POLL_PERIOD_SECOND=300
SUBGRAPH_ENDPOINT='https://api.thegraph.com/subgraphs/name/aminlatifi/givpower-deployment-six'
GIVPOWER_CONTRACT_ADDRESS='0x898Baa558A401e59Cb2aA77bb8b2D89978Cf506F'
PRIVATE_KEY=''
UNLOCK_PER_TRANSACTION=10
GAS_MAX_BASE_FEE=1.5
GAS_PRIORITY_FEE=1.5
NO_GAS_OVERRIDE=false
# Refuse to unlock rounds that closed more than this many rounds ago; they are
# a sign of stale subgraph data, and unlocking them does nothing but burn gas.
MAX_ROUND_AGE=5
# Stop sending after this many consecutive polls that unlocked nothing.
MAX_INEFFECTIVE_POLLS=3
# Max blocks the subgraph may trail the chain head when queried. Measured at
# 0-1 blocks in normal operation, so 10 is already generous. Raise only if a
# chain proves to need it.
SUBGRAPH_MAX_BLOCK_GAP=10
# How long to wait for an unlock transaction to be mined before giving up on
# it. Polling is serial, so an unmineable transaction would otherwise stop the
# bot polling entirely.
TX_WAIT_TIMEOUT_MS=180000
# --- Discord alerting (unset DISCORD_ALERT_WEBHOOK_URL to disable entirely) ---
DISCORD_ALERT_WEBHOOK_URL=
DISCORD_ALERT_SOURCE_LABEL=givpower-bot
# Which chain this instance runs against, shown on every alert. Six instances
# share one channel, so set this per instance - optimism / gnosis / zkevm.
# Left blank deliberately: a copied template that still says "optimism" would
# mislabel the Gnosis and zkEVM bots.
DISCORD_ALERT_CHAIN_LABEL=
# How long the same condition stays quiet after alerting.
DISCORD_ALERT_THROTTLE_MINUTES=60
# Quiet period after a failed send, so one Discord outage cannot turn a
# multi-chunk poll into a burst of slow failing requests.
DISCORD_ALERT_FAILURE_BACKOFF_MS=60000
# Post an informational message on every start, listing the effective config.
# It is the only alert that fires when nothing is wrong, so it is what proves
# the webhook works - a broken one otherwise looks exactly like a healthy bot.
# Set to false to turn it off.
DISCORD_ALERT_ON_STARTUP=true
DISCORD_ALERT_MENTION_USER_IDS=
DISCORD_ALERT_MENTION_ROLE_IDS=
# Used to link transactions in alerts. Set per instance, e.g.
# https://optimistic.etherscan.io / https://gnosisscan.io
EXPLORER_BASE_URL=
# Native-currency balance below which the wallet is reported as low.
MIN_WALLET_BALANCE=0.05
# How many claimed-unlockable users to verify against the chain each poll.
SUBGRAPH_MISMATCH_SAMPLE_SIZE=10
