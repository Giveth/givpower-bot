NODE_URL='https://rpc.gnosischain.com/'
POLL_PERIOD_SECOND=300
SUBGRAPH_ENDPOINT='https://api.thegraph.com/subgraphs/name/aminlatifi/givpower-deployment-six'
GIVPOWER_CONTRACT_ADDRESS='0x898Baa558A401e59Cb2aA77bb8b2D89978Cf506F'
PRIVATE_KEY=''
UNLOCK_PER_TRANSACTION=10
GAS_MAX_BASE_FEE=1.5
GAS_PRIORITY_FEE=1.5
NO_GAS_OVERRIDE=false
# Refuse to unlock rounds that closed more than this many rounds ago; they are
# a sign of stale subgraph data, and unlocking them does nothing but burn gas.
MAX_ROUND_AGE=5
# Stop sending after this many consecutive polls that unlocked nothing.
MAX_INEFFECTIVE_POLLS=3
# Max blocks the subgraph may trail the chain head when queried. Measured at
# 0-1 blocks in normal operation, so 10 is already generous. Raise only if a
# chain proves to need it.
SUBGRAPH_MAX_BLOCK_GAP=10
# How long to wait for an unlock transaction to be mined before giving up on
# it. Polling is serial, so an unmineable transaction would otherwise stop the
# bot polling entirely.
TX_WAIT_TIMEOUT_MS=180000
